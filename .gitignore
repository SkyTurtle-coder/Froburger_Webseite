# Standardmässig alles ignorieren
*

# Repository-Dateien
!.gitignore
!README.md
!docs/
!docs/**

# Eigener WordPress-Code
!wp-content/
wp-content/*

# Eigene Plugins
!wp-content/plugins/
wp-content/plugins/*

!wp-content/plugins/avf-events-integration/
!wp-content/plugins/avf-events-integration/**

!wp-content/plugins/avf-featured-post/
!wp-content/plugins/avf-featured-post/**

!wp-content/plugins/avf-zirkel-decor/
!wp-content/plugins/avf-zirkel-decor/**

!wp-content/plugins/avf-site-styles/
!wp-content/plugins/avf-site-styles/**

!wp-content/plugins/avf-homepage-layout/
!wp-content/plugins/avf-homepage-layout/**

# Eigene Must-use-Plugins, falls vorhanden
!wp-content/mu-plugins/
!wp-content/mu-plugins/**

# Eigene Child-Themes, falls später vorhanden
!wp-content/themes/
wp-content/themes/*
!wp-content/themes/hello-elementor-child/
!wp-content/themes/hello-elementor-child/**

# Niemals versionieren
wp-config.php
*.sql
*.sqlite
*.sqlite3
*.log
*.tmp
*.bak
*.old
*.zip
*.tar
*.gz
.env
.env.*
node_modules/
vendor/
.DS_Store
Thumbs.db

# Lokale QA- und Screenshot-Artefakte
tmp-avf-browser/
tools/
wp-content/mu-plugins/local-by-flywheel-live-link-helper.php
*-screenshot*.png
*headless*.png
qa-*.png
tmp-*.json
